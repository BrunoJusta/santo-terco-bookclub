rules_version = '2';

// Regras APENAS da base de dados "santo-terco-bookclub-prod".
// Toda a leitura e escrita passa pelo servidor Next.js (Admin SDK), que valida
// administradores, votos e reviews. Nenhum browser fala diretamente com o Firestore,
// por isso o acesso direto de clientes fica totalmente fechado.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
