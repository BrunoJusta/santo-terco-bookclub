# Copiar para .env.local (desenvolvimento) e criar as mesmas variáveis no Vercel.

# 1. Configuração Web do Firebase: colar o bloco tal como aparece em
#    Firebase Console > Definições do projeto > As suas apps > Configuração (const firebaseConfig = {...}).
#    No Vercel pode ir em várias linhas. Também dá o projeto e o bucket ao servidor.
NEXT_PUBLIC_FIREBASE_CONFIG=

# 2. Service account: colar o ficheiro JSON inteiro, tal como foi descarregado
#    (no .env.local tem de ficar numa só linha; no Vercel pode ter várias)
FIREBASE_SERVICE_ACCOUNT=
#    Alternativas: FIREBASE_SERVICE_ACCOUNT_BASE64, ou FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY

# 3. Admin inicial da Gestão (os restantes gerem-se na aba Admins)
ADMIN_BOOTSTRAP_EMAILS=bruno.justa@sogrape.pt

# Opcionais (já têm estes valores por omissão)
# NEXT_PUBLIC_MICROSOFT_TENANT=sogrape.pt
# FIREBASE_DATABASE_ID=santo-terco-bookclub-prod
# FIREBASE_STORAGE_PREFIX=santo-terco-bookclub-prod
# FIREBASE_PROJECT_ID / FIREBASE_STORAGE_BUCKET: só se quiseres sobrepor o que vem do bloco acima
