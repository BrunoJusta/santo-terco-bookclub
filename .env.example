# Copiar para .env.local (desenvolvimento) e configurar as mesmas variáveis no Vercel.

# Firebase Web (cliente, só usado para o login Google do backoffice). Firebase Console > Definições do projeto > As suas apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=sogrape-ai-studio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=sogrape-ai-studio
NEXT_PUBLIC_FIREBASE_APP_ID=

# Servidor (nunca expor ao browser)
FIREBASE_PROJECT_ID=sogrape-ai-studio
FIREBASE_DATABASE_ID=santo-terco-bookclub-prod
FIREBASE_STORAGE_BUCKET=sogrape-ai-studio.firebasestorage.app
# Pasta dentro do bucket onde ficam todas as imagens do clube
FIREBASE_STORAGE_PREFIX=santo-terco-bookclub-prod

# Service account: JSON completo codificado em base64 (base64 -i service-account.json | tr -d '\n')
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Emails com acesso garantido ao backoffice (separados por vírgula). Os restantes admins gerem-se na aba Admins.
ADMIN_BOOTSTRAP_EMAILS=bruno.justa@sogrape.pt
